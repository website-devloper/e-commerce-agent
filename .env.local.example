# ── AI ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=                              # Free key from console.groq.com (starts with gsk_)
ASSISTANT_MODEL=llama-3.3-70b-versatile   # or llama-3.1-8b-instant (faster/lighter)

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=file:./dev.db
# Production: DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require

# ── Notifications ─────────────────────────────────────────────────────────────
RESEND_API_KEY=
SLACK_WEBHOOK_URL=

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=

# ── WhatsApp / Twilio (Phase 6) ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
